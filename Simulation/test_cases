from __future__ import annotations

from dataclasses import dataclass
from math import ceil, isfinite
from typing import Any
import traceback

from env_time_weather import TimeWeatherEnv


@dataclass
class TestResult:
    name: str
    category: str
    passed: bool
    expected: str
    observed: str
    note: str = ""


class RealSystemTester:
    """
    Real-mode tester for the coupled system:
    - BernMap
    - MobilityModel
    - TimeWeatherEnv

    Fokus:
    1) Edge cases
    2) Zeitlogik
    3) Wetterlogik
    4) Mobility-Logik
    5) Interaktion von weather, time und mobility

    Diese Klasse arbeitet direkt mit dem echten Environment.

    Mit detailed=True werden die ausführlicheren Tests verwendet.
    Mit detailed=False laufen kürzere, schnellere Varianten.
    """

    def __init__(self, env: TimeWeatherEnv, detailed: bool = True):
        self.env = env
        self.results: list[TestResult] = []
        self.detailed = detailed

        if detailed:
            self._n_time_monotonic = 24
            self._n_precip_checks = 48
            self._n_night_checks = 48
            self._n_weather_change_steps = 12
            self._n_interaction_stability = 72
            self._n_parallel_updates = 10
            self._obs_limit = 8
        else:
            self._n_time_monotonic = 12
            self._n_precip_checks = 24
            self._n_night_checks = 24
            self._n_weather_change_steps = 6
            self._n_interaction_stability = 12
            self._n_parallel_updates = 6
            self._obs_limit = 6

    # ============================================================
    # BASIC HELPERS
    # ============================================================

    @staticmethod
    def _safe_text(text: Any) -> str:
        """
        Macht Text robust fuer Windows-Konsole (cp1252).
        """
        s = str(text)
        return s.encode("cp1252", errors="replace").decode("cp1252")

    def _record(
        self,
        name: str,
        category: str,
        passed: bool,
        expected: str,
        observed: str,
        note: str = "",
    ) -> TestResult:
        result = TestResult(
            name=name,
            category=category,
            passed=passed,
            expected=expected,
            observed=observed,
            note=note,
        )
        self.results.append(result)
        return result

    def _safe_test(self, fn):
        try:
            return fn()
        except Exception as e:
            return self._record(
                name=fn.__name__,
                category="exception",
                passed=False,
                expected="test runs without exception",
                observed=f"{type(e).__name__}: {e}",
                note=traceback.format_exc(limit=1),
            )

    @staticmethod
    def _rounded_hours_from_minutes(minutes: float) -> int:
        if minutes <= 0:
            return 0
        return int(ceil(minutes / 60.0))

    def _weather_state(self) -> dict[str, Any]:
        return {
            "temp": float(self.env._temp),
            "precip_mm": float(self.env._precip),
            "wet": int(self.env._wet_prev),
            "sun_frac": float(self.env._sun_frac),
            "humidity": float(self.env._humidity),
            "wind": float(self.env._wind),
            "snow_cover_flag": int(self.env._snow_cover_flag),
            "feels_like": float(self.env._feels_like),
        }

    def _time_state(self) -> dict[str, Any]:
        month, hour = self.env._month_hour(self.env._t)
        day_idx = self.env._t // 24
        return {
            "t": int(self.env._t),
            "month": int(month),
            "hour": int(hour),
            "day_idx": int(day_idx),
        }

    def _reset(self, seed: int = 123):
        obs, info = self.env.reset(seed=seed)
        return obs, info

    def _pick_existing_category(self) -> str:
        cats = self.env.mobility.get_categories()
        if len(cats) == 0:
            raise ValueError("No POI categories available after reset.")
        return cats[0]

    def _truncate_obs(self, seq: list[str]) -> str:
        return "; ".join(seq[: self._obs_limit]) + (" ..." if len(seq) > self._obs_limit else "")

    # ============================================================
    # 1) MOBILITY / EDGE CASES
    # ============================================================

    def test_home_is_initialized(self):
        self._reset()

        passed = (
            self.env.mobility.home_node is not None
            and self.env.mobility.current_node is not None
        )

        return self._record(
            name="test_home_is_initialized",
            category="mobility",
            passed=passed,
            expected="home_node and current_node are initialized after reset",
            observed=(
                f"home_node={self.env.mobility.home_node}, "
                f"current_node={self.env.mobility.current_node}"
            ),
            note="Nach reset() setzt das Env Home und Current Node neu.",
        )

    def test_reset_starts_at_home(self):
        self._reset()

        is_at_home = self.env.mobility.is_at_home()
        passed = bool(is_at_home)

        return self._record(
            name="test_reset_starts_at_home",
            category="mobility",
            passed=passed,
            expected="agent starts at home after reset",
            observed=f"is_at_home={is_at_home}",
            note="MobilityModel.reset_to_home() wird im reset() des Environments genutzt.",
        )

    def test_same_start_target_distance_zero(self):
        self._reset()

        node = self.env.mobility.current_node
        dist_walk = self.env.map.shortest_path_length_m(node, node, mode="walk")
        time_walk = self.env.map.travel_time_minutes(
            source_node=node,
            target_node=node,
            speed_kmh=self.env.mobility.walk_speed_kmh,
            mode="walk",
        )

        passed = abs(dist_walk) < 1e-9 and abs(time_walk) < 1e-9

        return self._record(
            name="test_same_start_target_distance_zero",
            category="mobility",
            passed=passed,
            expected="same source and target -> distance=0 and travel_time=0",
            observed=f"distance_walk={dist_walk}, time_walk={time_walk}",
            note="Wichtigster Edge Case im Routing.",
        )

    def test_invalid_transport_mode_raises(self):
        self._reset()

        try:
            self.env.mobility.get_travel_time_to_nearest_minutes("gym", mode="rocket")
            passed = False
            observed = "no exception raised"
        except Exception as e:
            passed = True
            observed = f"caught {type(e).__name__}"

        return self._record(
            name="test_invalid_transport_mode_raises",
            category="robustness",
            passed=passed,
            expected="unsupported mode raises exception",
            observed=observed,
            note="Sichert sauberes Fehlerhandling fuer ungueltige Modi ab.",
        )

    def test_unknown_category_raises(self):
        self._reset()

        try:
            self.env.mobility.get_travel_time_to_nearest_minutes(
                "unknown_category", mode="walk"
            )
            passed = False
            observed = "no exception raised"
        except Exception as e:
            passed = True
            observed = f"caught {type(e).__name__}"

        return self._record(
            name="test_unknown_category_raises",
            category="robustness",
            passed=passed,
            expected="unknown POI category raises exception",
            observed=observed,
            note="Wichtiger Edge Case fuer die POI-Logik.",
        )

    def test_transport_ordering_for_nearest_poi(self):
        self._reset()

        category = self._pick_existing_category()

        walk_t = self.env.mobility.get_travel_time_to_nearest_minutes(category, mode="walk")
        bike_t = self.env.mobility.get_travel_time_to_nearest_minutes(category, mode="bike")
        drive_t = self.env.mobility.get_travel_time_to_nearest_minutes(category, mode="drive")

        passed = drive_t < bike_t < walk_t

        return self._record(
            name="test_transport_ordering_for_nearest_poi",
            category="mobility",
            passed=passed,
            expected="drive < bike < walk for same destination logic",
            observed=f"walk={walk_t:.2f}, bike={bike_t:.2f}, drive={drive_t:.2f}",
            note="Plausibilitaetstest fuer Geschwindigkeiten und Routing.",
        )

    def test_go_to_nearest_changes_position(self):
        self._reset()

        category = self._pick_existing_category()
        before = self.env.mobility.current_node
        info = self.env.mobility.go_to_nearest(category, mode="walk")
        after = self.env.mobility.current_node

        passed = before != after or info["distance_m"] == 0.0

        return self._record(
            name="test_go_to_nearest_changes_position",
            category="mobility",
            passed=passed,
            expected="go_to_nearest changes current position unless already at nearest target",
            observed=f"before={before}, after={after}, info={info}",
            note="Prueft, ob Bewegung wirklich auf den POI-Nodes landet.",
        )

    def test_go_home_restores_home_position(self):
        self._reset()

        category = self._pick_existing_category()
        _ = self.env.mobility.go_to_nearest(category, mode="walk")
        info_home = self.env.mobility.go_home(mode="walk")

        passed = (
            self.env.mobility.current_node == self.env.mobility.home_node
            and self.env.mobility.is_at_home()
        )

        return self._record(
            name="test_go_home_restores_home_position",
            category="mobility",
            passed=passed,
            expected="go_home returns agent to home node",
            observed=(
                f"current_node={self.env.mobility.current_node}, "
                f"home_node={self.env.mobility.home_node}, "
                f"info={info_home}"
            ),
            note="Prueft Rueckkehrlogik des Agenten.",
        )

    # ============================================================
    # 2) TIME TESTS
    # ============================================================

    def test_time_starts_at_zero(self):
        self._reset()

        passed = self.env._t == 0

        return self._record(
            name="test_time_starts_at_zero",
            category="time",
            passed=passed,
            expected="simulation time starts at t=0 after reset",
            observed=f"t={self.env._t}",
            note="Baseline-Test fuer die gesamte Zeitlogik.",
        )

    def test_month_hour_bounds(self):
        self._reset()

        month, hour = self.env._month_hour(self.env._t)
        passed = 1 <= month <= 12 and 0 <= hour <= 23

        return self._record(
            name="test_month_hour_bounds",
            category="time",
            passed=passed,
            expected="month in [1,12] and hour in [0,23]",
            observed=f"month={month}, hour={hour}",
            note="Prueft Kalendergrenzen des internen Zeitmappings.",
        )

    def test_step_stay_advances_by_sample_rate(self):
        self._reset()

        before = self.env._t
        _, _, terminated, _, info = self.env.step(0)
        after = self.env._t

        expected_delta = self.env.sample_rate_hours
        observed_delta = after - before
        passed = observed_delta == expected_delta and not terminated

        return self._record(
            name="test_step_stay_advances_by_sample_rate",
            category="time",
            passed=passed,
            expected=f"stay action advances by sample_rate_hours={expected_delta}",
            observed=f"before={before}, after={after}, delta={observed_delta}, info={info}",
            note="Action 0 soll nur normalen Zeitfortschritt ausloesen.",
        )

    def test_travel_time_rounding_logic_in_step(self):
        self._reset()

        before_t = self.env._t
        _, _, _, _, info = self.env.step(1)
        after_t = self.env._t

        observed_delta = after_t - before_t
        step_travel_min = float(info["mobility"]["travel_time_min"])
        expected_delta = max(
            self.env.sample_rate_hours,
            self._rounded_hours_from_minutes(step_travel_min),
        )

        passed = observed_delta == expected_delta

        return self._record(
            name="test_travel_time_rounding_logic_in_step",
            category="time",
            passed=passed,
            expected="delta_hours = max(sample_rate_hours, ceil(travel_time_min / 60))",
            observed=(
                f"step_travel_min={step_travel_min:.2f}, "
                f"observed_delta={observed_delta}, expected_delta={expected_delta}"
            ),
            note="Zentraler Test fuer die Kopplung von mobility und Simulationszeit.",
        )

    def test_long_run_time_consistency(self):
        self._reset()

        n_steps = self._n_time_monotonic
        last_t = self.env._t
        ok = True

        for _ in range(n_steps):
            _, _, terminated, _, _ = self.env.step(0)
            if self.env._t <= last_t:
                ok = False
                break
            last_t = self.env._t
            if terminated:
                break

        return self._record(
            name="test_long_run_time_consistency",
            category="time",
            passed=ok,
            expected="time increases monotonically across repeated steps",
            observed=f"final_t={self.env._t} after {n_steps} stay-steps",
            note="Prueft, ob Zeit nie rueckwaerts laeuft.",
        )

    # ============================================================
    # 3) WEATHER TESTS
    # ============================================================

    def test_weather_ranges_after_reset(self):
        self._reset()

        w = self._weather_state()

        checks = {
            "sun_frac": 0.0 <= w["sun_frac"] <= 1.0,
            "humidity": 0.0 <= w["humidity"] <= 100.0,
            "wind": 0.0 <= w["wind"] <= 12.0,
            "precip_mm": w["precip_mm"] >= 0.0,
            "snow_cover_flag": w["snow_cover_flag"] in [0, 1],
            "wet": w["wet"] in [0, 1],
            "temp": -50.0 <= w["temp"] <= 60.0,
            "feels_like": -80.0 <= w["feels_like"] <= 70.0,
        }
        passed = all(checks.values())

        return self._record(
            name="test_weather_ranges_after_reset",
            category="weather",
            passed=passed,
            expected="all weather values within plausible bounds",
            observed=f"weather={w}, checks={checks}",
            note="Prueft die unmittelbare Plausibilitaet des Startwetters.",
        )

    def test_precip_wet_consistency(self):
        self._reset()

        ok = True
        observations = []

        for _ in range(self._n_precip_checks):
            _, _, terminated, _, _ = self.env.step(0)
            w = self._weather_state()

            if w["precip_mm"] > 0 and w["wet"] != 1:
                ok = False

            observations.append(f"(precip={w['precip_mm']:.2f}, wet={w['wet']})")

            if terminated:
                break

        return self._record(
            name="test_precip_wet_consistency",
            category="weather",
            passed=ok,
            expected="precip_mm > 0 implies wet=1",
            observed=self._truncate_obs(observations),
            note="Prueft interne Konsistenz zwischen Niederschlag und wet/dry-State.",
        )

    def test_night_has_low_or_zero_sun(self):
        self._reset()

        ok = True
        observations = []

        for _ in range(self._n_night_checks):
            _, _, terminated, _, _ = self.env.step(0)
            month, hour = self.env._month_hour(self.env._t)
            sun = self.env._sun_frac

            if hour in [1, 2, 3, 4] and sun > 0.1:
                ok = False

            if hour in [1, 2, 3, 4]:
                observations.append(f"(hour={hour}, sun_frac={sun:.3f}, month={month})")

            if terminated:
                break

        return self._record(
            name="test_night_has_low_or_zero_sun",
            category="weather",
            passed=ok,
            expected="during deep night hours sun_frac should be near zero",
            observed=self._truncate_obs(observations),
            note="Passt zu sunrise-/sunset-Logik.",
        )

    def test_weather_changes_over_time(self):
        self._reset()

        start = self._weather_state()

        for _ in range(self._n_weather_change_steps):
            self.env.step(0)

        end = self._weather_state()

        changed = any(
            abs(float(start[k]) - float(end[k])) > 1e-9
            for k in ["temp", "precip_mm", "sun_frac", "humidity", "wind", "feels_like"]
        )

        return self._record(
            name="test_weather_changes_over_time",
            category="weather",
            passed=changed,
            expected="weather state changes over repeated time steps",
            observed=f"start={start}, end={end}",
            note="Prueft, ob Wetter dynamisch simuliert wird.",
        )

