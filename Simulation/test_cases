    def test_bad_weather_does_not_break_step_loop(self):
        self._reset()

        ok = True
        observations = []

        for _ in range(self._n_interaction_stability):
            _, _, terminated, _, info = self.env.step(1)
            w = self._weather_state()

            finite_check = all(
                isfinite(float(x))
                for x in [
                    w["temp"],
                    w["precip_mm"],
                    w["sun_frac"],
                    w["humidity"],
                    w["wind"],
                    w["feels_like"],
                ]
            )
            if not finite_check:
                ok = False

            if info["delta_hours"] < 1:
                ok = False

            observations.append(
                f"(t={self.env._t}, wet={w['wet']}, precip={w['precip_mm']:.2f}, delta={info['delta_hours']})"
            )

            if terminated:
                break

        return self._record(
            name="test_bad_weather_does_not_break_step_loop",
            category="interaction",
            passed=ok,
            expected="repeated action-1 steps remain numerically stable under varying weather",
            observed=self._truncate_obs(observations),
            note="Stabilitaetstest fuer das gekoppelte Gesamtsystem.",
        )

    def test_mobility_location_updates_while_weather_updates(self):
        self._reset()

        positions = []
        temps = []

        for _ in range(self._n_parallel_updates):
            _, _, terminated, _, _ = self.env.step(1)
            positions.append(self.env.mobility.current_node)
            temps.append(self.env._temp)
            if terminated:
                break

        moved = len(set(positions)) >= 1
        weather_dynamic = len(set(round(float(t), 3) for t in temps)) > 1
        passed = moved and weather_dynamic

        return self._record(
            name="test_mobility_location_updates_while_weather_updates",
            category="interaction",
            passed=passed,
            expected="location and weather can both evolve across steps",
            observed=f"positions={positions}, temps={[round(float(x), 2) for x in temps]}",
            note="Zeigt die Parallelitaet von raeumlicher und meteorologischer Dynamik.",
        )

    # ============================================================
    # RUNNER
    # ============================================================

    def run_all(self):
        self.results = []

        tests = [
            # mobility / edge
            self.test_home_is_initialized,
            self.test_reset_starts_at_home,
            self.test_same_start_target_distance_zero,
            self.test_invalid_transport_mode_raises,
            self.test_unknown_category_raises,
            self.test_transport_ordering_for_nearest_poi,
            self.test_go_to_nearest_changes_position,
            self.test_go_home_restores_home_position,

            # time
            self.test_time_starts_at_zero,
            self.test_month_hour_bounds,
            self.test_step_stay_advances_by_sample_rate,
            self.test_travel_time_rounding_logic_in_step,
            self.test_long_run_time_consistency,

            # weather
            self.test_weather_ranges_after_reset,
            self.test_precip_wet_consistency,
            self.test_night_has_low_or_zero_sun,
            self.test_weather_changes_over_time,

            # state
            self.test_state_features_exist,
            self.test_observation_shape_matches_space,

            # interactions
            self.test_step_action_1_returns_mobility_info,
            self.test_action_1_advances_time_by_mobility_logic,
            self.test_weather_and_mobility_coexist_in_info,
            self.test_bad_weather_does_not_break_step_loop,
            self.test_mobility_location_updates_while_weather_updates,
        ]

        for test_fn in tests:
            self._safe_test(test_fn)

        return self.results

    # ============================================================
    # REPORTING
    # ============================================================

    def summary(self):
        total = len(self.results)
        passed = sum(r.passed for r in self.results)
        failed = total - passed

        by_category = {}
        for r in self.results:
            if r.category not in by_category:
                by_category[r.category] = {"total": 0, "passed": 0, "failed": 0}
            by_category[r.category]["total"] += 1
            if r.passed:
                by_category[r.category]["passed"] += 1
            else:
                by_category[r.category]["failed"] += 1

        return {
            "total": total,
            "passed": passed,
            "failed": failed,
            "by_category": by_category,
        }

    def print_report(self):
        s = self.summary()

        print("\n" + "=" * 84)
        print("REAL SYSTEM TEST REPORT: GPS / MOBILITY / TIME / WEATHER")
        print("=" * 84)
        print(f"Total tests : {s['total']}")
        print(f"Passed      : {s['passed']}")
        print(f"Failed      : {s['failed']}")
        print("-" * 84)

        for cat, vals in s["by_category"].items():
            print(
                self._safe_text(
                    f"[{cat.upper():12}] total={vals['total']} | "
                    f"passed={vals['passed']} | failed={vals['failed']}"
